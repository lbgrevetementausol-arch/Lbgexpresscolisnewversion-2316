# Configuration de LBG Express Colis.
# Copier ce fichier en .env a la racine, puis remplir les valeurs.
# Les variables VITE_ sont lues au moment du build : les modifier impose
# de relancer un deploiement, pas seulement un redemarrage.

# development en local, production sur le serveur
NODE_ENV=""

# base SQLite. Local : file:./local.db — Serveur : file:/var/lib/lbg-express/lbg.db
DATABASE_URL=""

# chaine aleatoire longue, signe les sessions. A garder secrete
BETTER_AUTH_SECRET=""

# adresse publique du site, utilisee dans les e-mails
WEBSITE_URL=""

# cle du compte OpenAI de l'entreprise (chat d'assistance)
OPENAI_API_KEY=""

# modele du chat, optionnel. Defaut : gpt-5.4-mini
AI_MODEL=""

# identifiant Google Analytics 4, format G-XXXXXXX. Variable de build
VITE_GA4_MEASUREMENT_ID=""

# cle Google Maps pour l'autocompletion d'adresses. Variable de build
VITE_GOOGLE_MAPS_API_KEY=""

# code d'entree de l'espace livreurs
PRO_ACCESS_CODE=""

# lien de paiement myPOS (serveur)
MYPOS_PAYMENT_URL=""

# meme lien, cote navigateur
VITE_MYPOS_PAYMENT_URL=""

# webhook des notifications WhatsApp
WHATSAPP_AUTOMATION_WEBHOOK_URL=""

# cle Resend, envoi des e-mails
RESEND_API_KEY=""

# expediteur des e-mails, sur un domaine verifie chez Resend
MAIL_FROM=""

# adresse qui recoit les alertes d'exploitation
MAIL_OPS=""

# true pour activer le paiement integre
MYPOS_CHECKOUT_ENABLED=""

# identifiants myPOS
MYPOS_STORE_ID=""

# identifiants myPOS
MYPOS_CLIENT_NUMBER=""

# identifiants myPOS
MYPOS_KEY_INDEX=""

# true pour l'environnement de test myPOS
MYPOS_SANDBOX=""

# cle privee myPOS encodee en base64
MYPOS_PRIVATE_KEY_B64=""

# certificat myPOS encode en base64
MYPOS_CERT_B64=""

# pack myPOS encode en base64
MYPOS_PACK_B64=""

# jeton protegeant les taches planifiees appelees en HTTP
CRON_SECRET=""

# lien de la page d'avis envoye aux clients
REVIEW_URL=""

# delai en jours avant la demande d'avis
REVIEW_DELAY_DAYS=""

# dossier des documents livreurs. Serveur : /var/lib/lbg-express/uploads
UPLOADS_DIR=""

# port d'ecoute du serveur, 4200
PORT=""
